    if (i == 5) return make_float4(210.0f, 378.0f, 65.0f, 65.0f); // YouTube Shorts
    if (i == 6 && p16 == 1 && strict == 1) return make_float4(0.0f, 272.0f, 40.0f, 40.0f); // LinkedIn
