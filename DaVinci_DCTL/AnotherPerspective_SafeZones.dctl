// =====================================================================
//  AnotherPerspective_SafeZones.dctl  -  v4.2  (powered by Another Perspective Pictures) (ottobre 2026)
//  Another Perspective Pictures
//
//  Overlay per video verticali 9:16: safe area (organica o ads ufficiale)
//  e mockup dell'interfaccia di ogni piattaforma (grafica nuova, disegnata in vettoriale).
//  Misure su canvas di riferimento 1080x1920, scalate alla timeline.
//
//  FILE GENERATO da tools/build.py partendo da tools/spec.py:
//  per correggere le misure modifica spec.py e rigenera.
//
//  Uso: pagina COLOR, OpenFX "DCTL" su un nodo (comodo su un Adjustment Clip).
//  Export: sempre 1080x1920 (9:16). Il menu Telefono non cambia il formato:
//  mostra quanta interfaccia cade sul video su quel tipo di schermo.
//  RICORDA di disattivarlo prima del render.
// =====================================================================

DEFINE_UI_PARAMS(szPlat, Piattaforma, DCTLUI_COMBO_BOX, 2, {PF_ALL, PF_COMMON, PF_0, PF_1, PF_2, PF_3, PF_4, PF_5, PF_6, PF_7, PF_8, PF_9, PF_10, PF_11, PF_12, PF_13}, {Tutte le piattaforme, Area comune feed verticali, TikTok, Instagram Reels, Instagram Stories, Facebook Reels, Facebook Stories, YouTube Shorts, LinkedIn, Snapchat Spotlight, Snapchat da profilo, Snapchat Stories, Pinterest, LinkedIn 4x5, TikTok schermo pieno, Pinterest pin 1 a 2})
DEFINE_UI_PARAMS(szMode, Modalita, DCTLUI_COMBO_BOX, 3, {MODE_SAFE_ORG, MODE_SAFE_ADS, MODE_MOCKUP, MODE_BOTH}, {Safe area organica, Safe area ads ufficiale, Mockup interfaccia, Mockup e safe area})
DEFINE_UI_PARAMS(szPhone, Telefono, DCTLUI_COMBO_BOX, 0, {PHONE_TALL, PHONE_169}, {Telefono moderno iPhone X e successivi e Android recenti, Telefono 16 9 iPhone SE 8 e Android vecchi})
DEFINE_UI_PARAMS(szStrict, Elementi occasionali, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(szShade, Safezone, DCTLUI_SLIDER_FLOAT, 0.45, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(szUiOp, Mockup, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(szMargin, Margin px, DCTLUI_SLIDER_INT, 16, 0, 120, 1)
DEFINE_UI_PARAMS(szLineW, Border, DCTLUI_SLIDER_INT, 4, 0, 20, 1)
DEFINE_UI_PARAMS(szGrid, Crop griglia profilo 3x4, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(szFeed, Crop feed 4x5, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(szCenter, Croce centrale, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(szFlip, Correggi se capovolto, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(szBrand, Powered by Another Perspective Pictures, DCTLUI_CHECK_BOX, 1)

#define REF_W 1080.0f
#define REF_H 1920.0f
#define NPLAT 14

// ---------------------------------------------------------------------
//  Primitive di disegno (coordinate nel canvas 1080x1920)
//  0 RECT (angoli arrotondati r)  1 RING (cerchio vuoto)  2 CIRC (cerchio pieno)
//  3 HEART  4 TRI (freccia)  5 GRAD (sfumatura scura)  6 OUTL (contorno arrotondato)
//  7 ELLIPSE (ellisse piena)  8 BOOKMARK (segnalibro pieno)
// ---------------------------------------------------------------------
__DEVICE__ float sdBox(float u, float v, float cx, float cy, float hw, float hh, float r)
{
    float qx = _fabs(u - cx) - hw + r;
    float qy = _fabs(v - cy) - hh + r;
    float ox = _fmaxf(qx, 0.0f), oy = _fmaxf(qy, 0.0f);
    return _sqrtf(ox * ox + oy * oy) + _fminf(_fmaxf(qx, qy), 0.0f) - r;
}

__DEVICE__ float covg(float d, float px)
{
    return _fminf(_fmaxf(0.5f - d / px, 0.0f), 1.0f);
}

__DEVICE__ float3 drawEl(float3 c, float u, float v, float px, int t,
                    float cx, float cy, float w, float h, float r,
                    float cr, float cg, float cb, float a)
{
    float k = 0.0f;
    if (a <= 0.0f) return c;
    if (t == 0) {
        k = covg(sdBox(u, v, cx, cy, w * 0.5f, h * 0.5f, r), px);
    } else if (t == 1) {
        float s = _fmaxf(w * 0.09f, 4.0f);
        float d = _sqrtf((u - cx) * (u - cx) + (v - cy) * (v - cy));
        k = covg(_fabs(d - w * 0.5f + s * 0.5f) - s * 0.5f, px);
    } else if (t == 2) {
        float d = _sqrtf((u - cx) * (u - cx) + (v - cy) * (v - cy));
        k = covg(d - w * 0.5f, px);
    } else if (t == 3) {
        float x = (u - cx) / (w * 0.5f) * 1.25f;
        float y = -(v - cy) / (h * 0.5f) * 1.25f + 0.25f;
        float q = x * x + y * y - 1.0f;
        k = (q * q * q - x * x * y * y * y <= 0.0f) ? 1.0f : 0.0f;
    } else if (t == 4) {
        float hw = _fabs(w) * 0.5f, hh = h * 0.5f;
        float x = (w < 0.0f) ? (cx - u) : (u - cx), y = v - cy;
        k = (x >= -hw && x <= hw && _fabs(y) <= hh * (hw - x) / (2.0f * hw)) ? 1.0f : 0.0f;
    } else if (t == 5) {
        if (h > 0.0f) {
            float y0 = cy - h * 0.5f;
            k = _fminf(_fmaxf((v - y0) / h, 0.0f), 1.0f);
            if (v < y0) k = 0.0f;
        } else {
            float hh = -h;
            k = (v < hh) ? (1.0f - v / hh) : 0.0f;
        }
    } else if (t == 6) {
        k = covg(_fabs(sdBox(u, v, cx, cy, w * 0.5f, h * 0.5f, r)) - 2.5f, px);
    } else if (t == 7) {
        float ex = (u - cx) / (w * 0.5f), ey = (v - cy) / (h * 0.5f);
        float dd = _sqrtf(ex * ex + ey * ey);
        k = covg((dd - 1.0f) * _fminf(w, h) * 0.5f, px);
    } else if (t == 8) {
        float x = u - cx, y = v - cy, hw = w * 0.5f, hh = h * 0.5f;
        float notch = (hh - y) - h * 0.28f * (1.0f - _fabs(x) / hw);
        k = (_fabs(x) <= hw && y >= -hh && notch >= 0.0f) ? 1.0f : 0.0f;
    }
    k = k * a;
    return make_float3(c.x + (cr - c.x) * k, c.y + (cg - c.y) * k, c.z + (cb - c.z) * k);
}

// margini ORGANICI calcolati dall'ingombro reale degli elementi UI (+16 px di respiro)
// float4 = (top, bottom, left, right) ; rail = (larghezza colonna icone, inizio y)
// strict = 1 include anche gli elementi occasionali d'angolo (muto storie FB, bolla amici IG)
// NB: qui i margini sono SENZA respiro: il DCTL aggiunge szMargin a runtime
// p16 = 1 telefono compatto 16:9 (l'interfaccia sale sul video)
