    if (i == 8) return make_float3(1.0f, 0.8f, 0.3f);
    if (i == 9) return make_float3(0.8f, 0.8f, 0.3f);
    if (i == 10) return make_float3(0.2f, 1.0f, 0.3f);
    if (i == 11) return make_float3(0.3f, 0.7f, 1.0f);
    if (i == 12) return make_float3(0.0f, 0.8f, 0.8f);
    if (i == 13) return make_float3(0.1f, 0.8f, 0.3f);
    return make_float3(1.0f, 1.0f, 1.0f);
}

// piattaforme incluse nell'area comune (feed verticali)
__DEVICE__ int inCommon(int i)
{
    if (i == 0) return 1;
    if (i == 1) return 1;
    if (i == 2) return 0;
    if (i == 3) return 1;
    if (i == 4) return 0;
    if (i == 5) return 1;
    if (i == 6) return 1;
    if (i == 7) return 1;
    if (i == 8) return 0;
    if (i == 9) return 0;
    if (i == 10) return 0;
    if (i == 11) return 0;
    if (i == 12) return 0;
    if (i == 13) return 0;
    return 0;
}



// ---------------------------------------------------------------------
__DEVICE__ int insideRect(float u, float v, float4 m, float2 rail, float RH)
{
    if (u < m.z || u > REF_W - m.w || v < m.x || v > RH - m.y) return 0;
    if (rail.x > 0.0f && v >= rail.y && u > REF_W - rail.x) return 0;
    return 1;
}

// i margini organici sono senza respiro: qui si aggiunge il Margin scelto nell'interfaccia
__DEVICE__ float4 zoneM(int i, int useAds, int p16, int st, float m)
{
    if (useAds == 1) return adsM(i);
    float4 a = orgM(i, p16, st);
    return make_float4(_fmaxf(a.x + m, 40.0f), _fmaxf(a.y + m, 40.0f), _fmaxf(a.z, m), _fmaxf(a.w, m));
}
__DEVICE__ float2 zoneR(int i, int useAds, int p16, int st, float m)
{
    if (useAds == 1) return adsRail(i);
    float2 r = orgRail(i, p16, st);
    return make_float2(r.x > 0.0f ? r.x + m : 0.0f, r.y - m);
}

// sel: -1 = area comune (intersezione di tutte), 0..N-1 = piattaforma ; p16 = 1 telefono compatto 16:9
__DEVICE__ int safeAt(float u, float v, int sel, int useAds, int p16, float RH, int st, float m)
{
    if (sel >= 0) return insideRect(u, v, zoneM(sel, useAds, p16, st, m), zoneR(sel, useAds, p16, st, m), RH);
    for (int i = 0; i < NPLAT; i++) {
        if (inCommon(i) == 1) {
            if (insideRect(u, v, zoneM(i, useAds, p16, st, m), zoneR(i, useAds, p16, st, m), RH) == 0) return 0;
        }
    }
    return 1;
}

__DEVICE__ int borderAt(float u, float v, float lw, int sel, int useAds, int p16, float RH, int st, float m)
{
    if (lw <= 0.0f) return 0;
    if (safeAt(u, v, sel, useAds, p16, RH, st, m) == 0) return 0;
    if (safeAt(u + lw, v, sel, useAds, p16, RH, st, m) == 0) return 1;
    if (safeAt(u - lw, v, sel, useAds, p16, RH, st, m) == 0) return 1;
    if (safeAt(u, v + lw, sel, useAds, p16, RH, st, m) == 0) return 1;
    if (safeAt(u, v - lw, sel, useAds, p16, RH, st, m) == 0) return 1;
    return 0;
}

